*.xcuserstate

# ───────────────────────── Web (Node) ──────────────────────
web/node_modules/
web/dist/
web/.vite/
web/dev-dist/

# Android release signing — never commit the keystore or its passwords
keystore.properties
*.jks
*.keystore

# Regenerable store screenshots (make screenshots)
/screenshots/
