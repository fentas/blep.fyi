# ───────────────────────── General ─────────────────────────
.DS_Store
*.log
.idea/
*.iml
.vscode/
.fleet/

# ───────────────────────── mise ────────────────────────────
# Keep mise.toml (pinned toolchain), ignore local installs
.mise/

# ───────────────────────── Kotlin / Gradle ─────────────────
app/.gradle/
app/build/
app/*/build/
app/local.properties
app/.kotlin/
*.hprof
captures/

# ───────────────────────── iOS / Xcode ─────────────────────
app/iosApp/build/
app/iosApp/Pods/
app/iosApp/*.xcworkspace/xcuserdata/
app/iosApp/**/xcuserdata/
*.xcuserstate

# ───────────────────────── Web (Node) ──────────────────────
web/node_modules/
web/dist/
web/.vite/
web/dev-dist/

# Android release signing — never commit the keystore or its passwords
keystore.properties
*.jks
*.keystore

# Google Play Publisher API service-account key — private key, never commit
sa.json
*-sa.json
*.sa.json

# Regenerable store screenshots (make screenshots)
/screenshots/

# BLE netsim test tooling
tools/ble-netsim/venv/
tools/ble-netsim/__pycache__/

# local venv for tools/publish-listing.py
.venv-publish/

# Per-release "what's new" drafts (regenerated by tools/release-notes.sh)
store/release-notes/*.txt

# Generated demo/promo videos (make promo / FGS demo) — artifacts, not source
*.mp4

# Kernel core dumps. The Android emulator (qemu) writes one into whatever
# directory it was launched from when it crashes, and it is a full image of the
# emulator's RAM — gigabytes, and never something to commit. Unanchored, since
# `make emulator` runs from the repo root but a bare gradle/emulator invocation
# can drop one in app/ instead.
core.[0-9]*

# Claude Code local agent state
.claude/
