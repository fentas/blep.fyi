<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Library components, merged into the host app (:androidApp). Absolute class
         names because this module's namespace (fyi.blep.shared) differs from the
         classes' package (fyi.blep). Permissions + the launcher Activity live in
         the app manifest. -->
    <application>

        <!-- Captures the app context for background-scan plumbing. -->
        <provider
            android:name="fyi.blep.BlepAppInitProvider"
            android:authorities="${applicationId}.blepappinit"
            android:exported="false" />

        <!-- Keeps a safety scan alive off-screen (passive advertisement scan only). -->
        <service
            android:name="fyi.blep.BackgroundScanService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
