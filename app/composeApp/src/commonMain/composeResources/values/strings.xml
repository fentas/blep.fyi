    <string name="settings_storage_confirm_title">Clear stored data?</string>
    <string name="settings_storage_confirm_body">blep forgets every device it has learned — names, history, identified info, and the tracker log. Your settings stay.</string>
    <string name="settings_section_background">Background scanning</string>
    <string name="settings_foreground_title">Keep scanning when minimized</string>
    <string name="settings_foreground_desc">Keeps a live scan running when you leave blep — real-time, more battery.</string>
    <string name="settings_background_title">Scan in the background</string>
    <string name="settings_background_desc">Quick checks on a timer while blep is closed — light on battery.</string>
    <string name="settings_interval_min">Every %1$d min</string>
    <string name="settings_interval_h">Every %1$d h</string>
    <string name="settings_interval_hm">Every %1$d h %2$d min</string>
    <string name="settings_background_info">Both watch only for trackers that seem to follow you, and never use your location. ‘When minimized’ keeps a continuous scan running (with a notification) once you leave blep — best detection, more battery. ‘In the background’ wakes on the interval for a quick look while blep is fully closed — lighter, but it can miss things between checks.</string>
