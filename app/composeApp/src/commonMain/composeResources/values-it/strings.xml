    <string name="sensitivity_balanced">Bilanciata</string>
    <string name="sensitivity_strict">Rigorosa</string>
    <string name="sensitivity_relaxed_hint">Meno avvisi — per luoghi affollati.</string>
    <string name="sensitivity_balanced_hint">Un buon valore per ogni giorno.</string>
    <string name="sensitivity_strict_hint">Più vigile — segnala prima, può avvisare di più.</string>
    <string name="settings_location_title">Rilevamento con posizione</string>
    <string name="settings_location_desc">Annota un luogo approssimativo, sul dispositivo, quando vede un tracker, per distinguere un inseguitore dalla tua routine. Non lascia mai il telefono.</string>
