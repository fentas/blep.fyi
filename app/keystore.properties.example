# Copy to `keystore.properties` (same dir = gradle root) and fill in. NEVER commit
# the real file or the .jks — both are gitignored. In CI, write this file from
# repo secrets (and base64-decode the .jks) before the release build.
#
# Generate an upload key:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
# Google Play App Signing then manages the real app-signing key; you only ever
# hold this *upload* key.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
