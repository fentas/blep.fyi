<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>blep</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>WKApplication</key>
    <true/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>blep uses Bluetooth to find and guide you to your nearby devices.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>blep uses your heading and location to map your path and point you toward the device.</string>
    <key>NSMotionUsageDescription</key>
    <string>blep uses motion to tell when you’re walking or turning, sharpening the guidance.</string>
</dict>
</plist>
